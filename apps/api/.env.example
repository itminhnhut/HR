# Neon Postgres. On Vercel the Neon integration (Marketplace) sets it; locally use a Neon dev branch.
# The driver talks to Neon over WebSockets, so a plain local Postgres will not work here.
DATABASE_URL=

# Vercel Blob, PRIVATE store, for CV files. On Vercel the SDK finds it; locally set the token.
BLOB_READ_WRITE_TOKEN=

# Vercel Blob, PUBLIC store, for news images (covers and pictures in articles). A store is public or
# private for good, so this is a SECOND store: create it with access "Public" and paste its read-write
# token here and in Vercel env. Empty locally = images are files in apps/api/.data/news-images.
NEWS_BLOB_READ_WRITE_TOKEN=

# Google sign-in for CANDIDATES (OAuth client "Web application"), same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# HR accounts are not configured here: they have their own password, see scripts/hr-user.ts.
# Random, 32+ characters, signs the session cookies: openssl rand -base64 32
SESSION_SECRET=

# Public site, used in share pages and the sitemap. FE and BE share this domain.
SITE_URL=https://tuyendung.congty.vn
COMPANY_NAME=Tên công ty

# Candidates sign in with Google only (no phone/OTP sign-in).

# Cloudflare Turnstile ("Tôi không phải robot"). Real keys live only in Vercel env and your local .env:
# NEVER commit them. Empty = CAPTCHA off.
TURNSTILE_SECRET_KEY=

# IndexNow (Bing, Cốc Cốc…): told at once when a news post or job is published, edited or taken down.
# Any random 8-128 characters of a-z, A-Z, 0-9 and "-", e.g. a UUID from `uuidgen`. Production only;
# the API serves it back at /<key>.txt to prove the site is ours. Empty = off.
INDEXNOW_KEY=
