# Neon Postgres. On Vercel the Neon integration (Marketplace) sets it; locally use a Neon dev branch.
# The driver talks to Neon over WebSockets, so a plain local Postgres will not work here.
DATABASE_URL=

# Vercel Blob, PRIVATE store, for CV files. On Vercel the SDK finds it; locally set the token.
BLOB_READ_WRITE_TOKEN=

# Google sign-in (OAuth client of type "Web application"), same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Google accounts allowed into /hr, comma separated. Removing one revokes access at once.
HR_EMAILS=
# Random, 32+ characters, signs the session cookies: openssl rand -base64 32
SESSION_SECRET=

# Public site, used in share pages and the sitemap. FE and BE share this domain.
SITE_URL=https://tuyendung.congty.vn
COMPANY_NAME=Tên công ty

# Phone sign-in (OTP): no SMS/Zalo provider yet. Locally the code is printed in the terminal;
# on Vercel phone sign-in answers 503 until a provider is added (BR-17). Google sign-in still works.
