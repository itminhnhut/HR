# Neon Postgres (Vercel Marketplace adds this automatically)
DATABASE_URL=

# Vercel Blob, PRIVATE store. On Vercel the SDK uses OIDC; locally set the token.
BLOB_READ_WRITE_TOKEN=

# Google sign-in for HR (OAuth client of type "Web application")
GOOGLE_CLIENT_ID=
# Gmail addresses allowed into /hr, comma separated
HR_EMAILS=
# Random 32+ chars, signs the HR session cookie: openssl rand -base64 32
SESSION_SECRET=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Optional: email HR about new applications and expiring jobs
RESEND_API_KEY=
NOTIFY_FROM="Tuyển dụng <tuyendung@yourdomain.vn>"

# Public site (the FRONTEND domain), used in emails, sitemap and share pages
SITE_URL=https://your-domain.vn
COMPANY_NAME=Tên công ty
