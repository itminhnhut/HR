{
  "name": "@careers/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @careers/shared && tsx watch --env-file=.env src/dev.ts",
    "build": "npm run build -w @careers/shared",
    "typecheck": "tsc --noEmit -p .",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "dependencies": {
    "@careers/shared": "*",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22",
    "dotenv": "^16",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4"
  }
}
