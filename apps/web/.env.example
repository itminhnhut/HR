# Để trống = dùng dữ liệu giả trong trình duyệt (chạy thử không cần BE).
# Có BE (apps/api, cùng domain trên Vercel) thì đặt: /api
VITE_API_URL=

# Đăng nhập Google, cùng giá trị GOOGLE_CLIENT_ID của BE
VITE_GOOGLE_CLIENT_ID=
# Chỉ khi chạy dev ở máy, chưa có Google Client ID: đăng nhập Google bằng email này (BE local chấp nhận)
# VITE_DEV_GOOGLE_EMAIL=hr@congty.vn

# Thông tin công ty hiển thị trên trang
VITE_COMPANY_NAME=[Tên công ty]
VITE_HR_EMAIL=[email HR]
VITE_HR_PHONE=[số điện thoại]
VITE_HR_ZALO=
VITE_SITE_URL=https://tuyendung.congty.vn

# Cloudflare Turnstile site key. Real keys live only in Vercel env and .env.local: NEVER commit them.
# Empty = CAPTCHA off.
VITE_TURNSTILE_SITE_KEY=
